# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Secrets & local configuration - never commit real credentials
.env
.env.*
!.env.example

# Local model / embedding caches
.cache/
models_cache/
*.faiss

# Private user documents: only the fictional samples in data/examples are tracked
data/uploads/
data/private/
*.private.*

# Editors / OS
.vscode/
.idea/
.DS_Store

# --- Job-market data (see data/README.md) ---
# Reference CSV (231 MB) is downloaded by `python -m market.ingestion.hf_data_jobs`.
data/raw/hf_data_jobs/*.csv
data/raw/hf_data_jobs/*.part
# Raw API pages contain full job descriptions (sometimes with recruiters' phone
# numbers): kept locally, only the manifest with checksums is committed.
data/raw/arbeitnow/*/page_*.json
data/processed/arbeitnow/descriptions.csv.gz
# Large regenerated tables
data/processed/data_jobs/

# =====================================================================
# AI Job Interview & Application Coach - configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# =====================================================================

# --- LLM provider -----------------------------------------------------
# "openai_compatible" : any OpenAI-compatible Chat Completions API
#                       (OpenAI, Google Gemini, Groq, Ollama, LM Studio...)
# "offline"           : no LLM. Questions/feedback are produced by deterministic
#                       templates + heuristics over the retrieved context.
#                       Useful for development, tests and as a demo safety net.
LLM_PROVIDER=openai_compatible

# Model name as expected by the provider.
LLM_MODEL=gpt-4o-mini

# API key for the provider (leave empty for local Ollama).
LLM_API_KEY=

# Base URL of the OpenAI-compatible endpoint. Leave empty for api.openai.com.
#   Google Gemini : https://generativelanguage.googleapis.com/v1beta/openai/   (LLM_MODEL=gemini-flash-latest)
#   Groq          : https://api.groq.com/openai/v1                             (LLM_MODEL=llama-3.3-70b-versatile)
#   Ollama        : http://localhost:11434/v1                                  (LLM_MODEL=llama3.1)
LLM_BASE_URL=

# Sampling temperature. Low values keep structured outputs stable.
LLM_TEMPERATURE=0.3
# Seconds before an LLM request is abandoned.
LLM_TIMEOUT_SECONDS=60
# When the LLM fails (network error, invalid JSON twice...), fall back to the
# offline generator instead of returning an error. The UI labels such results.
LLM_FALLBACK_TO_OFFLINE=true

# --- Embeddings -------------------------------------------------------
# "sentence_transformers" : real semantic embeddings (downloaded once from Hugging Face)
# "hashing"               : deterministic bag-of-words hashing vectors, no download
#                           (used by the test-suite; NOT semantically meaningful)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Chunking ---------------------------------------------------------
# Max tokens per chunk (must stay below the embedding model limit of 256).
CHUNK_MAX_TOKENS=200
# Tokens of overlap carried from one chunk to the next.
CHUNK_OVERLAP_TOKENS=30

# --- Retrieval --------------------------------------------------------
RETRIEVAL_TOP_K=4

# --- Matching score weights (must be non-negative; they are re-normalised) ---
MATCH_WEIGHT_SKILL_OVERLAP=0.40
MATCH_WEIGHT_REQUIREMENT_COVERAGE=0.35
MATCH_WEIGHT_SEMANTIC_SIMILARITY=0.15
MATCH_WEIGHT_EXPERIENCE=0.10

# --- Misc -------------------------------------------------------------
LOG_LEVEL=INFO
# Maximum accepted upload size in megabytes.
MAX_UPLOAD_MB=5
